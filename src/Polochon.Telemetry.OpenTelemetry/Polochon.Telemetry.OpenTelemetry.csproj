<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Polochon.Telemetry.OpenTelemetry</PackageId>
    <Description>OpenTelemetry export (OTLP, console) of the Polochon kernel's traces, metrics and logs, host and modules.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Polochon.Abstractions/Polochon.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polochon.Telemetry.OpenTelemetry.Tests" />
  </ItemGroup>

</Project>
